# Neon connection string (Dashboard → Connection details → pooled). For a
# zero-setup local database use:  DATABASE_URL=pglite://.data/dev
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# `neon link` / `neon deploy` write DATABASE_URL here for you.

# What you type on the login screen.
APP_PASSCODE=change-me

# 32+ random characters used to sign the session cookie:  openssl rand -base64 32
SESSION_SECRET=

# "Today" is computed in this timezone.
APP_TIMEZONE=Asia/Colombo
